{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noor-al-aman-humanitarian",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  }
}
